PORT=4000
NODE_ENV=development
DATABASE_URL="mysql://user:password@host:3306/database?connect_timeout=300"
JWT_ACCESS_SECRET=replace_with_secure_access_secret
JWT_REFRESH_SECRET=replace_with_secure_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
UPLOAD_DIR=./uploads
CORS_ORIGIN=http://localhost:4200,https://your-frontend-domain.example
MAX_UPLOAD_FILES=5
